flowchart TD
    start(["START"])
    read[/"Read number of levels"/]
    valid{"Whole number in 1 to 9?"}
    retry["Print error<br/>Retry size"]
    init["dimension = 2 * size - 1<br/>digit_count = 0"]
    row["Take the next row<br/>Start an empty line"]
    edges["Find mirrored level<br/>left = size - level + 1<br/>right = size + level - 1"]
    column["Take the next column"]
    edge{"Column matches<br/>either edge?"}
    digit["Append level digit<br/>Increment digit count"]
    space["Append one space"]
    columns{"More columns?"}
    print[/"Remove trailing spaces<br/>Print the line"/]
    rows{"More rows?"}
    summary[/"Print height, maximum width<br/>and digit count"/]
    end(["STOP"])
    start --> read
    read --> valid
    valid -->|Yes| init
    valid -->|No| retry
    retry --> read
    init --> row
    row --> edges
    edges --> column
    column --> edge
    edge -->|Yes| digit
    edge -->|No| space
    digit --> columns
    space --> columns
    columns -->|Yes| column
    columns -->|No| print
    print --> rows
    rows -->|Yes| row
    rows -->|No| summary
    summary --> end
