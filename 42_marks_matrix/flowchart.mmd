flowchart TD
    start(["START"])
    setup[/"Read and validate matrix dimensions"/]
    subjects[/"Read unique valid subject codes<br/>Retry until the list has correct length"/]
    read[/"Read student ID and all marks"/]
    valid{"New valid ID, complete row,<br/>and integer marks 0 to 100?"}
    retry["Print error<br/>Retry this student row"]
    store["Append ID and marks row<br/>to parallel lists"]
    more{"More students to read?"}
    rows["Scan each row: total and average<br/>Check every subject against 40<br/>Classify; retain all top-total ties"]
    columns["Scan each column: total, average,<br/>minimum, maximum and all toppers<br/>Flag subject average below 50"]
    summary[/"Print row and column reports<br/>Print overall average and top ties"/]
    end(["STOP"])
    start --> setup
    setup --> subjects
    subjects --> read
    read --> valid
    valid -->|Yes| store
    valid -->|No| retry
    retry --> read
    store --> more
    more -->|Yes| read
    more -->|No| rows
    rows --> columns
    columns --> summary
    summary --> end
