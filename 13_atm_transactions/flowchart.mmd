flowchart TD
    start(["START"])
    setup[/"Validate opening balance and count<br/>Initialize balance, totals and seen IDs"/]
    read[/"Read the next ID | type | amount"/]
    valid{"Valid format, new ID,<br/>type and positive amount?"}
    policy{"Deposit OR all withdrawal<br/>conditions satisfied?"}
    reject["Record first rejection reason<br/>Keep balance unchanged"]
    update["Apply deposit or withdrawal<br/>Update successful totals and count"]
    log["Append status and resulting balance<br/>to the transaction audit"]
    more{"More attempts?"}
    summary[/"Print audit, counts and totals<br/>Opening + deposits - withdrawals<br/>= closing balance"/]
    end(["STOP"])
    start --> setup
    setup --> read
    read --> valid
    valid -->|Yes| policy
    valid -->|No| reject
    policy -->|Yes| update
    policy -->|No| reject
    reject --> log
    update --> log
    log --> more
    more -->|Yes| read
    more -->|No| summary
    summary --> end
