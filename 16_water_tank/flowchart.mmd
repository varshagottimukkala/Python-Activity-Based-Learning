flowchart TD
    start(["START"])
    setup[/"Validate capacity, initial level,<br/>threshold and interval count"/]
    init["Set current level and totals<br/>If initial &gt;= threshold, record interval 0"]
    read[/"Read inflow | demand"/]
    valid{"Two nonnegative<br/>whole quantities?"}
    retry["Print error<br/>Retry this interval"]
    fill["Save start level and add inflow"]
    spill["If above capacity: record spill<br/>and cap the stored level"]
    threshold["Record first threshold crossing<br/>if filled level &gt;= threshold"]
    serve["Supply demand up to available level<br/>Record shortage and subtract supply"]
    store["Accumulate flows<br/>Append interval audit tuple"]
    more{"More intervals?"}
    summary[/"Print audit, first crossing and totals<br/>Check water conservation"/]
    end(["STOP"])
    start --> setup
    setup --> init
    init --> read
    read --> valid
    valid -->|Yes| fill
    valid -->|No| retry
    retry --> read
    fill --> spill
    spill --> threshold
    threshold --> serve
    serve --> store
    store --> more
    more -->|Yes| read
    more -->|No| summary
    summary --> end
